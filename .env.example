# Copiar a .env si se quieren cambiar los valores por defecto.
# docker compose lee este archivo automaticamente.

# --- Kafka ---
KAFKA_BROKERS=kafka:9092
KAFKA_EXTERNAL_PORT=29092

# --- MongoDB ---
MONGO_URI=mongodb://mongo:27017/rutasur?replicaSet=rs0
MONGO_DB=rutasur

# --- Reloj simulado ---
# 1 hora simulada = 30 segundos reales => factor 120
SIM_SPEEDUP=120

# --- Simulador ---
SIM_SHIPMENTS_PER_MINUTE=20
SIM_SEED=42
SIM_HUB_DELAY_PROB=0.10
SIM_DUPLICADO_PROB=0.02
SIM_DESORDEN_PROB=0.02
SIM_MALFORMADO_PROB=0.01
SIM_EXPRESS_PROB=0.15
SIM_PROMISE_HORAS=24

# --- Monitor de SLA ---
SLA_TICK_MS=60000

# --- Puertos en el host ---
WEB_PORT=3000
SIMULADOR_PORT=4000
CONTROL_PORT=4100
MONGO_PORT=27018
